# Weekly price refresh, run as a systemd user service.
# Install: see "Weekly refresh" in README.md. Edit WorkingDirectory if the
# repository lives somewhere else.
[Unit]
Description=Refresh retro-analytics prices, forecasts and report
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Projects/retro-analytics
ExecStart=%h/.local/bin/uv run --frozen ra run
# A full scrape takes 15-20 minutes; stop a run that hangs so later weeks still start.
TimeoutStartSec=2h
# To publish to the results repository (README, "Phone export and
# publishing"), uncomment both lines:
#EnvironmentFile=%h/.config/retro-analytics/env
#Environment="GIT_SSH_COMMAND=ssh -i %h/.ssh/retro_analytics_data -o IdentitiesOnly=yes"
# To score underrated games with IGDB (README, "Underrated games"), uncomment:
#EnvironmentFile=-%h/.config/retro-analytics/igdb.env
Nice=10
